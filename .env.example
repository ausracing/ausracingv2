# =============================================================================
# Environment Variables — copy to .env.local and fill in real values
# =============================================================================

# Newsletter Subscription (Resend)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
CONTACT_FORM_FROM_EMAIL=check_internal_docs
CONTACT_FORM_TO_EMAIL="ausracing@aus.edu"

# Sanity CMS — get these from https://manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Hiring Page Toggle — set to "true" to show the hiring page, "false" to hide it
# Only for local development; in production, this is controlled by the environment variable in Vercel
NEXT_PUBLIC_HIRING_OPEN="true"